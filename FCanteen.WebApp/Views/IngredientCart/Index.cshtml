@model List<FCanteen.WebApp.Models.IngredientCartItem>

@{
    ViewData["Title"] = "Ingredient Cart";
}

<h1>Giỏ Nhập Nguyên Liệu</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row">
    <div class="col-md-4">
        <h4>Thêm nguyên liệu</h4>
        <form asp-action="Add" method="post">
            <div class="form-group mb-2">
                <label>Chọn nguyên liệu</label>
                <select name="ingredientId" class="form-control">
                    @foreach (var item in ViewBag.Ingredients)
                    {
                        <option value="@item.Id">@item.Name (@item.Unit)</option>
                    }
                </select>
            </div>
            <div class="form-group mb-2">
                <label>Số lượng</label>
                <input type="number" name="quantity" class="form-control" step="0.1" value="1" min="0.1" />
            </div>
            <button type="submit" class="btn btn-primary">Thêm vào giỏ</button>
        </form>
    </div>
    
    <div class="col-md-8">
        <h4>Danh sách chờ nhập</h4>
        @if (Model.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Tên nguyên liệu</th>
                        <th>Số lượng</th>
                        <th>Đơn vị</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>
                                <form asp-action="Update" method="post" class="d-inline">
                                    <input type="hidden" name="ingredientId" value="@item.IngredientId" />
                                    <input type="number" name="quantity" value="@item.Quantity" step="0.1" style="width: 80px;" />
                                    <button type="submit" class="btn btn-sm btn-info">Cập nhật</button>
                                </form>
                            </td>
                            <td>@item.Unit</td>
                            <td>
                                <a asp-action="Remove" asp-route-id="@item.IngredientId" class="btn btn-sm btn-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            <form asp-action="Checkout" method="post">
                <button type="submit" class="btn btn-success">Xác nhận nhập kho</button>
            </form>
        }
        else
        {
            <p>Giỏ trống.</p>
        }
    </div>
</div>
