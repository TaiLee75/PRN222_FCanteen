@model FCanteen.WebApp.Models.PaginatedList<FCanteen.Data.Entities.MenuItem>

@{
    ViewData["Title"] = "Menu Items";
}

<h1>Menu Items</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<form asp-action="Index" method="get" class="form-inline mb-3">
    <div class="form-group mr-2">
        <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Tìm tên / mã món" />
    </div>
    <div class="form-group mr-2">
        <select name="categoryId" asp-items="ViewBag.Categories" class="form-control">
            <option value="">-- Tất cả nhóm --</option>
        </select>
    </div>
    <div class="form-group mr-2">
        <select name="isAvailable" class="form-control">
            <option value="">-- Trạng thái --</option>
            <option value="true" selected="@(ViewBag.CurrentIsAvailable == true ? "selected" : null)">Đang bán</option>
            <option value="false" selected="@(ViewBag.CurrentIsAvailable == false ? "selected" : null)">Ngừng bán</option>
        </select>
    </div>
    <button type="submit" class="btn btn-secondary">Filter</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault()!.Id)
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-categoryId="@ViewBag.CurrentCategory" asp-route-isAvailable="@ViewBag.CurrentIsAvailable">
                    @Html.DisplayNameFor(model => model.FirstOrDefault()!.Name)
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault()!.Category!.Name)
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParm"]" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-categoryId="@ViewBag.CurrentCategory" asp-route-isAvailable="@ViewBag.CurrentIsAvailable">
                    @Html.DisplayNameFor(model => model.FirstOrDefault()!.Price)
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault()!.CostPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault()!.Unit)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault()!.IsAvailable)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category!.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CostPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Unit)
            </td>
            <td>
                @(item.IsAvailable ? "Yes" : "No")
            </td>
            <td>
                <a asp-action="ManageIngredients" asp-route-id="@item.Id" class="btn btn-sm btn-success">Ingredients</a> |
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<a asp-action="Index"
   asp-route-sortOrder="@ViewBag.CurrentSort"
   asp-route-pageNumber="@(Model.PageIndex - 1)"
   asp-route-searchString="@ViewData["CurrentSearch"]"
   asp-route-categoryId="@ViewBag.CurrentCategory"
   asp-route-isAvailable="@ViewBag.CurrentIsAvailable"
   class="btn btn-default @prevDisabled">
    Previous
</a>
<a asp-action="Index"
   asp-route-sortOrder="@ViewBag.CurrentSort"
   asp-route-pageNumber="@(Model.PageIndex + 1)"
   asp-route-searchString="@ViewData["CurrentSearch"]"
   asp-route-categoryId="@ViewBag.CurrentCategory"
   asp-route-isAvailable="@ViewBag.CurrentIsAvailable"
   class="btn btn-default @nextDisabled">
    Next
</a>
