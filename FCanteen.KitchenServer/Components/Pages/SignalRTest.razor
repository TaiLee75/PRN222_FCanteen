@page "/signalr-test"
@rendermode InteractiveServer
@using FCanteen.KitchenServer.Hubs
@using FCanteen.KitchenServer.Hubs.Dtos
@using FCanteen.Data
@using FCanteen.Data.Entities
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject FCanteen.KitchenServer.Services.IOrderNotificationService NotificationService
@inject IDbContextFactory<FCanteenContext> DbFactory

<PageTitle>SignalR Test & Monitor</PageTitle>

<div class="container-fluid mt-3">
    <div class="row">
        <!-- Cột điều khiển & Thông số -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4 border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="m-0"><i class="bi bi-broadcast"></i> SignalR OrderHub Status (YC1)</h5>
                    <span class="badge @(_isConnected ? "bg-success" : "bg-warning text-dark")">
                        @(_isConnected ? "Đã kết nối" : "Đang kết nối...")
                    </span>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded mb-3">
                        <div>
                            <h6 class="text-muted m-0">Số thiết bị online (UpdateConnectionCount):</h6>
                            <h2 class="text-primary m-0 fw-bold">@_connectionCount</h2>
                        </div>
                        <div class="text-end">
                            <small class="text-muted">Connection ID:</small>
                            <div class="font-monospace small text-truncate" style="max-width: 200px;">@(_connectionId ?? "Đang kết nối...")</div>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2"><i class="bi bi-diagram-3"></i> Quản lý Groups (YC3):</h6>
                    <div class="mb-3">
                        <span class="me-2">Nhóm hiện tại:</span>
                        @if (_currentGroups.Any())
                        {
                            @foreach (var g in _currentGroups)
                            {
                                <span class="badge bg-info text-dark me-1 p-2">@g</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Chưa tham gia nhóm nào</span>
                        }
                    </div>

                    <div class="btn-group w-100 mb-2">
                        <button class="btn btn-outline-primary" @onclick='() => JoinGroupAsync("branch:DN:kitchen")'>Vào Bếp Đà Nẵng</button>
                        <button class="btn btn-outline-warning" @onclick='() => JoinGroupAsync("branch:HL:kitchen")'>Vào Bếp Hoà Lạc</button>
                        <button class="btn btn-outline-success" @onclick='() => JoinGroupAsync("order:TEST-ORD-01")'>Vào Đơn TEST-01</button>
                        <button class="btn btn-outline-danger" @onclick="LeaveAllGroupsAsync">Rời nhóm</button>
                    </div>

                    <hr />

                    <h6 class="fw-bold mb-2"><i class="bi bi-send"></i> Phát sự kiện thử nghiệm:</h6>
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-success btn-sm" @onclick="SendTestOrderCreatedDN">
                            1. Quầy phát đơn mới cho Bếp Đà Nẵng (branch:DN:kitchen)
                        </button>
                        <button class="btn btn-outline-info btn-sm" @onclick="SendTestOrderStatusChanged">
                            2. Bếp đổi trạng thái đơn TEST-ORD-01 -> "Sẵn sàng"
                        </button>
                        <button class="btn btn-outline-warning btn-sm" @onclick="SendTestMenuItemSoldOut">
                            3. Báo hết hàng món M01 (MenuItemSoldOut)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bảng Notification gần nhất từ CSDL -->
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h6 class="m-0"><i class="bi bi-database"></i> Dữ liệu bảng Notification (5 sự kiện mới nhất)</h6>
                    <button class="btn btn-sm btn-outline-light py-0" @onclick="LoadRecentNotificationsAsync">Làm mới</button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 250px;">
                        <table class="table table-sm table-striped m-0 small">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Loại sự kiện</th>
                                    <th>Đối tượng</th>
                                    <th>Nội dung</th>
                                    <th>Thời điểm</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var n in _recentNotifications)
                                {
                                    <tr>
                                        <td>@n.Id</td>
                                        <td><span class="badge bg-secondary">@n.EventType</span></td>
                                        <td><code>@n.Recipient</code></td>
                                        <td class="text-truncate" style="max-width: 180px;" title="@n.Content">@n.Content</td>
                                        <td>@n.CreatedAt.ToString("HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột Log sự kiện nhận được qua SignalR -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-success">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="m-0"><i class="bi bi-terminal"></i> Log sự kiện Client nhận Realtime</h5>
                    <button class="btn btn-sm btn-light py-0" @onclick="ClearLogs">Xoá Log</button>
                </div>
                <div class="card-body p-2 bg-dark text-light font-monospace overflow-auto" style="height: 550px;">
                    @if (!_eventLogs.Any())
                    {
                        <div class="text-muted p-2 text-center">Đang chờ sự kiện từ SignalR OrderHub...</div>
                    }
                    else
                    {
                        @foreach (var log in _eventLogs)
                        {
                            <div class="border-bottom border-secondary py-1">
                                <span class="text-warning">[@log.Timestamp.ToString("HH:mm:ss.fff")]</span>
                                <span class="badge bg-info text-dark">@log.Type</span>:
                                <span>@log.Message</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _isConnected = false;
    private string? _connectionId;
    private int _connectionCount = 0;
    private List<string> _currentGroups = new();
    private List<LogEntry> _eventLogs = new();
    private List<Notification> _recentNotifications = new();
    private DotNetObjectReference<SignalRTest>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadRecentNotificationsAsync();
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("signalRHelper.start", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnConnected(string connectionId)
    {
        _isConnected = true;
        _connectionId = connectionId;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnUpdateConnectionCount(int count)
    {
        _connectionCount = count;
        AddLog("UpdateConnectionCount", $"Số kết nối cập nhật: {count}");
        await InvokeAsync(StateHasChanged);
        await LoadRecentNotificationsAsync();
    }

    [JSInvokable]
    public async Task OnOrderCreated(OrderCreatedDto order)
    {
        AddLog("OrderCreated", $"[Nhận Đơn Mới] Mã: {order.TicketId} - Chi nhánh: {order.BranchCode} - Tiền: {order.TotalAmount:N0}đ");
        await InvokeAsync(StateHasChanged);
        await LoadRecentNotificationsAsync();
    }

    [JSInvokable]
    public async Task OnOrderStatusChanged(OrderStatusChangedDto status)
    {
        AddLog("OrderStatusChanged", $"[Đổi Trạng Thái] Mã: {status.TicketId} -> {status.NewStatusText} bởi {status.ChangedBy}");
        await InvokeAsync(StateHasChanged);
        await LoadRecentNotificationsAsync();
    }

    [JSInvokable]
    public async Task OnMenuItemSoldOut(string id, string name)
    {
        AddLog("MenuItemSoldOut", $"[HẾT HÀNG] Món ăn [{id}] '{name}' đã hết bán!");
        await InvokeAsync(StateHasChanged);
        await LoadRecentNotificationsAsync();
    }

    private async Task JoinGroupAsync(string group)
    {
        if (!_currentGroups.Contains(group))
        {
            if (group.StartsWith("branch:") && group.EndsWith(":kitchen"))
            {
                var branch = group.Split(':')[1];
                await JS.InvokeVoidAsync("signalRHelper.joinGroup", "JoinBranchKitchen", branch);
            }
            else if (group.StartsWith("order:"))
            {
                var code = group.Split(':')[1];
                await JS.InvokeVoidAsync("signalRHelper.joinGroup", "JoinOrderTrack", code);
            }
            _currentGroups.Add(group);
            AddLog("JoinGroup", $"Đã gia nhập nhóm: {group}");
        }
    }

    private async Task LeaveAllGroupsAsync()
    {
        foreach (var group in _currentGroups.ToList())
        {
            if (group.StartsWith("branch:") && group.EndsWith(":kitchen"))
            {
                var branch = group.Split(':')[1];
                await JS.InvokeVoidAsync("signalRHelper.leaveGroup", "LeaveBranchKitchen", branch);
            }
            else if (group.StartsWith("order:"))
            {
                var code = group.Split(':')[1];
                await JS.InvokeVoidAsync("signalRHelper.leaveGroup", "LeaveOrderTrack", code);
            }
        }
        _currentGroups.Clear();
        AddLog("LeaveGroups", "Đã rời khỏi tất cả các nhóm.");
    }

    private async Task SendTestOrderCreatedDN()
    {
        var testOrder = new OrderCreatedDto
        {
            TicketId = $"TEST-DN-{DateTime.Now:HHmmss}",
            BranchCode = "DN",
            PosName = "POS_QUAY_01",
            TotalAmount = 45000,
            CreatedAt = DateTime.Now,
            Status = 1
        };
        await NotificationService.PublishOrderCreatedAsync(testOrder);
        await LoadRecentNotificationsAsync();
    }

    private async Task SendTestOrderStatusChanged()
    {
        var statusDto = new OrderStatusChangedDto
        {
            TicketId = "TEST-ORD-01",
            BranchCode = "DN",
            OldStatus = 2,
            NewStatus = 3,
            NewStatusText = "Sẵn sàng nhận món",
            ChangedBy = "BepTruong_DN",
            ChangedAt = DateTime.Now
        };
        await NotificationService.PublishOrderStatusChangedAsync(statusDto);
        await LoadRecentNotificationsAsync();
    }

    private async Task SendTestMenuItemSoldOut()
    {
        await NotificationService.PublishMenuItemSoldOutAsync("M01", "Cơm gà xối mỡ");
        await LoadRecentNotificationsAsync();
    }

    private async Task LoadRecentNotificationsAsync()
    {
        using var context = DbFactory.CreateDbContext();
        _recentNotifications = await context.Notifications
            .OrderByDescending(n => n.CreatedAt)
            .Take(5)
            .ToListAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void AddLog(string type, string message)
    {
        _eventLogs.Insert(0, new LogEntry { Timestamp = DateTime.Now, Type = type, Message = message });
        if (_eventLogs.Count > 50) _eventLogs.RemoveAt(_eventLogs.Count - 1);
    }

    private void ClearLogs()
    {
        _eventLogs.Clear();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("signalRHelper.stop");
        }
        catch { }
        _dotNetRef?.Dispose();
    }

    public class LogEntry
    {
        public DateTime Timestamp { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }
}
