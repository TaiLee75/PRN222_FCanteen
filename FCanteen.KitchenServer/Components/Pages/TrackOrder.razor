@page "/track"
@page "/track/{OrderCode}"
@rendermode InteractiveServer
@using FCanteen.Data
@using FCanteen.Data.Entities
@using FCanteen.KitchenServer.Hubs.Dtos
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject IDbContextFactory<FCanteenContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Theo dõi đơn hàng #@OrderCode</PageTitle>

<div class="container py-4">
    <!-- Thanh tìm kiếm mã đơn nhanh -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <form @onsubmit="SearchOrder" class="d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" 
                                   placeholder="Nhập mã đơn hàng của bạn (ví dụ: ORD-DN-123456)..." 
                                   @bind="_inputCode" />
                        </div>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Tra cứu</button>
                    </form>

                    <!-- Gợi ý đơn gần đây để người dùng click test nhanh -->
                    @if (_recentSampleOrders.Any())
                    {
                        <div class="mt-2 small text-muted d-flex align-items-center gap-1 flex-wrap">
                            <span>Đơn gần đây:</span>
                            @foreach (var sample in _recentSampleOrders)
                            {
                                <a href="javascript:void(0)" class="badge bg-light text-primary border text-decoration-none me-1"
                                   @onclick="() => NavigateToOrder(sample.TicketId)">
                                    #@sample.TicketId (@GetStatusName(sample.Status))
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (string.IsNullOrWhiteSpace(OrderCode))
    {
        <!-- Màn hình chào mừng khi chưa nhập mã đơn -->
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center py-5">
                <div class="display-1 text-primary mb-3">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <h3 class="fw-bold text-dark">Tra cứu tiến trình đơn hàng FCanteen</h3>
                <p class="text-muted">Nhập mã phiếu in trên hoá đơn để theo dõi thời gian thực món ăn của bạn đang ở bước nào.</p>
            </div>
        </div>
    }
    else if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang tìm kiếm thông tin đơn hàng #@OrderCode...</p>
        </div>
    }
    else if (_order == null)
    {
        <!-- Không tìm thấy đơn hàng -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="alert alert-warning shadow-sm border-0 p-4 text-center">
                    <i class="bi bi-exclamation-triangle-fill fs-1 text-warning mb-2 d-block"></i>
                    <h4 class="alert-heading fw-bold">Không tìm thấy đơn hàng!</h4>
                    <p class="mb-0">Mã đơn <strong>#@OrderCode</strong> không tồn tại trong hệ thống. Vui lòng kiểm tra lại mã in trên phiếu thu.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- GIAO DIỆN CHÍNH THEO DÕI ĐƠN HÀNG (YC5) -->
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <!-- Thẻ trạng thái & Tiến trình trực quan -->
                <div class="card shadow-sm border-0 mb-4 overflow-hidden">
                    <div class="card-header bg-primary text-white p-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="badge bg-light text-primary mb-1">Cơ sở: @(_order.BranchCode == "DN" ? "Đà Nẵng" : "Hoà Lạc") (@_order.BranchCode)</span>
                                <h3 class="m-0 fw-bold">Đơn hàng #@_order.TicketId</h3>
                                <small class="text-light opacity-75">
                                    <i class="bi bi-clock"></i> Đặt lúc: @_order.CreatedAt.ToString("HH:mm:ss dd/MM/yyyy") | Quầy: @_order.PosName
                                </small>
                            </div>
                            <div class="text-md-end">
                                <span class="badge @(_isConnected ? "bg-success" : "bg-warning text-dark") p-2 shadow-sm">
                                    <i class="bi @(_isConnected ? "bi-broadcast" : "bi-arrow-repeat")"></i>
                                    @(_isConnected ? "Realtime SignalR: Đang kết nối" : "Đang kết nối SignalR...")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <!-- BANNER THỜI GIAN CHỜ ƯỚC TÍNH (YC5) -->
                        @if (_order.Status == (int)OrderStatus.Ready)
                        {
                            <div class="alert alert-success border-0 shadow-sm d-flex align-items-center gap-3 p-3 mb-4 animate-pulse">
                                <i class="bi bi-bell-fill fs-1 text-success"></i>
                                <div>
                                    <h5 class="alert-heading fw-bold m-0 text-success">MÓN ĂN ĐÃ SẴN SÀNG!</h5>
                                    <p class="m-0">Vui lòng mang phiếu thu đến quầy <strong>@_order.PosName</strong> để nhận món ngay nhé.</p>
                                </div>
                            </div>
                        }
                        else if (_order.Status == (int)OrderStatus.Delivered)
                        {
                            <div class="alert alert-secondary border-0 d-flex align-items-center gap-3 p-3 mb-4">
                                <i class="bi bi-check-circle-fill fs-2 text-success"></i>
                                <div>
                                    <h6 class="fw-bold m-0 text-dark">ĐƠN HÀNG ĐÃ HOÀN TẤT</h6>
                                    <p class="m-0 small text-muted">Cảm ơn bạn đã dùng bữa tại căng tin FPT University. Chúc bạn ngon miệng!</p>
                                </div>
                            </div>
                        }
                        else if (_order.Status == (int)OrderStatus.Cancelled)
                        {
                            <div class="alert alert-danger border-0 d-flex align-items-center gap-3 p-3 mb-4">
                                <i class="bi bi-x-circle-fill fs-2 text-danger"></i>
                                <div>
                                    <h6 class="fw-bold m-0">ĐƠN HÀNG ĐÃ BỊ HUỶ</h6>
                                    <p class="m-0 small">Đơn hàng này đã bị huỷ bởi nhà bếp hoặc quầy thu ngân.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- ƯỚC TÍNH THỜI GIAN CHỜ DỰA TRÊN SỐ ĐƠN XẾP TRƯỚC (YC5) -->
                            <div class="card bg-light border-0 p-3 mb-4 rounded-3 border-start border-4 border-warning">
                                <div class="d-flex justify-content-between align-items-center flex-wrap">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-warning bg-opacity-25 p-3 rounded-circle text-warning fs-3">
                                            <i class="bi bi-hourglass-split"></i>
                                        </div>
                                        <div>
                                            <h6 class="text-muted text-uppercase mb-1 small fw-bold">Ước tính thời gian chờ</h6>
                                            <h4 class="fw-bold text-dark m-0">
                                                ~@_estimatedMinutes phút
                                            </h4>
                                            <small class="text-secondary">
                                                @if (_ordersAhead == 0)
                                                {
                                                    <span>Bếp đang chế biến ngay đơn của bạn!</span>
                                                }
                                                else
                                                {
                                                    <span>Hiện có <strong class="text-primary">@_ordersAhead đơn</strong> đang xếp trước bạn trong bếp.</span>
                                                }
                                            </small>
                                        </div>
                                    </div>
                                    <div class="text-end mt-2 mt-md-0">
                                        <span class="badge bg-warning text-dark py-2 px-3 fw-bold">
                                            <i class="bi bi-people-fill"></i> Đang chờ: @_ordersAhead đơn trước
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- TIẾN TRÌNH TRỰC QUAN QUA CÁC TRẠNG THÁI (VISUAL STEPPER - YC5) -->
                        <h6 class="fw-bold text-muted text-uppercase mb-3 small">Tiến trình chuẩn bị món</h6>

                        @if (_order.Status == (int)OrderStatus.Cancelled)
                        {
                            <div class="progress mb-4" style="height: 10px;">
                                <div class="progress-bar bg-danger" style="width: 100%;"></div>
                            </div>
                        }
                        else
                        {
                            <div class="position-relative m-4">
                                <!-- Thanh tiến trình ngầm -->
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" 
                                         role="progressbar" 
                                         style="width: @GetProgressPercentage(_order.Status)%;"></div>
                                </div>

                                <!-- 4 Điểm mốc trạng thái (Steps) -->
                                <div class="d-flex justify-content-between position-absolute top-50 start-0 w-100 translate-middle-y">
                                    <!-- Bước 1: Chờ tiếp nhận -->
                                    <div class="text-center" style="width: 80px;">
                                        <button class="btn btn-sm rounded-circle shadow-sm @(_order.Status >= 1 ? "btn-success" : "btn-secondary")" 
                                                style="width: 36px; height: 36px; padding: 0;">
                                            @if (_order.Status > 1) { <i class="bi bi-check-lg"></i> } else { <span>1</span> }
                                        </button>
                                        <div class="small fw-bold mt-2 @(_order.Status == 1 ? "text-primary" : "text-muted")">
                                            Chờ tiếp nhận
                                        </div>
                                    </div>

                                    <!-- Bước 2: Đang chế biến -->
                                    <div class="text-center" style="width: 80px;">
                                        <button class="btn btn-sm rounded-circle shadow-sm @(_order.Status >= 2 ? "btn-success" : "btn-secondary")" 
                                                style="width: 36px; height: 36px; padding: 0;">
                                            @if (_order.Status > 2) { <i class="bi bi-check-lg"></i> } else { <span>2</span> }
                                        </button>
                                        <div class="small fw-bold mt-2 @(_order.Status == 2 ? "text-primary" : "text-muted")">
                                            Đang nấu
                                        </div>
                                    </div>

                                    <!-- Bước 3: Sẵn sàng -->
                                    <div class="text-center" style="width: 80px;">
                                        <button class="btn btn-sm rounded-circle shadow-sm @(_order.Status >= 3 ? "btn-success" : "btn-secondary")" 
                                                style="width: 36px; height: 36px; padding: 0;">
                                            @if (_order.Status > 3) { <i class="bi bi-check-lg"></i> } else { <span>3</span> }
                                        </button>
                                        <div class="small fw-bold mt-2 @(_order.Status == 3 ? "text-success fw-bolder" : "text-muted")">
                                            Sẵn sàng
                                        </div>
                                    </div>

                                    <!-- Bước 4: Đã giao -->
                                    <div class="text-center" style="width: 80px;">
                                        <button class="btn btn-sm rounded-circle shadow-sm @(_order.Status >= 4 ? "btn-success" : "btn-secondary")" 
                                                style="width: 36px; height: 36px; padding: 0;">
                                            <span>4</span>
                                        </button>
                                        <div class="small fw-bold mt-2 @(_order.Status == 4 ? "text-dark" : "text-muted")">
                                            Đã giao
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <hr class="my-5" />

                        <!-- CHI TIẾT DANH SÁCH MÓN ĂN TRONG ĐƠN -->
                        <h6 class="fw-bold text-muted text-uppercase mb-3 small">Danh sách món đã đặt</h6>
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Món ăn</th>
                                        <th class="text-center" style="width: 90px;">Số lượng</th>
                                        <th class="text-end" style="width: 140px;">Đơn giá</th>
                                        <th class="text-end" style="width: 140px;">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_order.TicketLines != null && _order.TicketLines.Any())
                                    {
                                        foreach (var line in _order.TicketLines)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@(line.MenuItem?.Name ?? "Món đã xoá")</strong>
                                                    @if (!string.IsNullOrWhiteSpace(line.Note))
                                                    {
                                                        <br /><small class="text-danger fst-italic">Ghi chú: @line.Note</small>
                                                    }
                                                </td>
                                                <td class="text-center fw-bold">@line.Quantity</td>
                                                <td class="text-end">@line.UnitPrice.ToString("N0") đ</td>
                                                <td class="text-end fw-bold">@((line.Quantity * line.UnitPrice).ToString("N0")) đ</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-light">
                                        <td colspan="3" class="text-end fw-bold">Tổng thanh toán:</td>
                                        <td class="text-end fw-bold text-primary fs-5">@_order.TotalAmount.ToString("N0") đ</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- LỊCH SỬ THAY ĐỔI TRẠNG THÁI -->
                        @if (_histories.Any())
                        {
                            <h6 class="fw-bold text-muted text-uppercase mt-4 mb-2 small">Nhật ký cập nhật từ Bếp</h6>
                            <ul class="list-group list-group-flush border rounded small">
                                @foreach (var h in _histories)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                        <div>
                                            <span class="badge bg-secondary me-2">@GetStatusName(h.NewStatus)</span>
                                            <span>Thao tác bởi <strong>@h.ChangedBy</strong></span>
                                        </div>
                                        <span class="text-muted">@h.ChangedAt.ToString("HH:mm:ss dd/MM/yyyy")</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? OrderCode { get; set; }

    private string _inputCode = string.Empty;
    private bool _isLoading = false;
    private bool _isConnected = false;
    private OrderTicket? _order;
    private int _ordersAhead = 0;
    private int _estimatedMinutes = 0;
    private List<OrderTicket> _recentSampleOrders = new();
    private List<OrderStatusHistory> _histories = new();
    private DotNetObjectReference<TrackOrder>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadSampleOrdersAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(OrderCode))
        {
            _inputCode = OrderCode;
            await LoadOrderDetailsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("signalRHelper.start", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnConnected(string connectionId)
    {
        _isConnected = true;
        if (!string.IsNullOrWhiteSpace(OrderCode))
        {
            // YC3: Khách hàng chỉ gia nhập nhóm theo dõi chính đơn của mình: order:{orderCode}
            await JS.InvokeVoidAsync("signalRHelper.joinGroup", "JoinOrderTrack", OrderCode);
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUpdateConnectionCount(int count) => Task.CompletedTask;

    [JSInvokable]
    public Task OnOrderCreated(OrderCreatedDto order)
    {
        // Khi có đơn mới trong hệ thống, cập nhật lại số đơn xếp trước
        _ = InvokeAsync(async () =>
        {
            if (_order != null)
            {
                using var context = DbFactory.CreateDbContext();
                await CalculateWaitTimeAsync(context, _order);
                StateHasChanged();
            }
        });
        return Task.CompletedTask;
    }

    /// <summary>
    /// YC5: Tự cập nhật khi Bếp thao tác đổi trạng thái, KHÔNG CẦN TẢI LẠI TRANG
    /// </summary>
    [JSInvokable]
    public async Task OnOrderStatusChanged(OrderStatusChangedDto status)
    {
        if (_order != null && status.TicketId == _order.TicketId)
        {
            await LoadOrderDetailsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task OnMenuItemSoldOut(string id, string name) => Task.CompletedTask;

    private async Task LoadOrderDetailsAsync()
    {
        if (string.IsNullOrWhiteSpace(OrderCode)) return;

        _isLoading = true;
        using var context = DbFactory.CreateDbContext();

        _order = await context.OrderTickets.AsNoTracking()
            .Include(o => o.TicketLines)
            .ThenInclude(t => t.MenuItem)
            .FirstOrDefaultAsync(o => o.TicketId == OrderCode);

        if (_order != null)
        {
            // Tải lịch sử trạng thái của đơn
            _histories = await context.OrderStatusHistories.AsNoTracking()
                .Where(h => h.TicketId == OrderCode)
                .OrderByDescending(h => h.ChangedAt)
                .ToListAsync();

            // Tính toán thời gian chờ ước tính dựa trên số đơn xếp trước (YC5)
            await CalculateWaitTimeAsync(context, _order);

            // Tham gia nhóm SignalR của đơn này nếu đã kết nối
            if (_isConnected)
            {
                await JS.InvokeVoidAsync("signalRHelper.joinGroup", "JoinOrderTrack", OrderCode);
            }
        }

        _isLoading = false;
    }

    /// <summary>
    /// YC5: Thuật toán ước tính thời gian chờ dựa trên số đơn đang xếp trước
    /// </summary>
    private async Task CalculateWaitTimeAsync(FCanteenContext context, OrderTicket order)
    {
        if (order.Status == (int)OrderStatus.Ready || order.Status == (int)OrderStatus.Delivered || order.Status == (int)OrderStatus.Cancelled)
        {
            _ordersAhead = 0;
            _estimatedMinutes = 0;
            return;
        }

        // Đếm số đơn cùng cơ sở đang chờ (Pending = 1) hoặc đang nấu (Processing = 2) được tạo trước đơn này
        _ordersAhead = await context.OrderTickets.AsNoTracking()
            .CountAsync(o => o.BranchCode == order.BranchCode && 
                           (o.Status == (int)OrderStatus.Pending || o.Status == (int)OrderStatus.Processing) &&
                           o.CreatedAt < order.CreatedAt);

        // Công thức: Mỗi đơn xếp trước trung bình mất 4 phút + 3 phút hoàn thành đơn hiện tại
        _estimatedMinutes = (_ordersAhead * 4) + (order.Status == (int)OrderStatus.Processing ? 2 : 4);
    }

    private async Task LoadSampleOrdersAsync()
    {
        using var context = DbFactory.CreateDbContext();
        _recentSampleOrders = await context.OrderTickets.AsNoTracking()
            .OrderByDescending(o => o.CreatedAt)
            .Take(4)
            .ToListAsync();
    }

    private void SearchOrder()
    {
        if (!string.IsNullOrWhiteSpace(_inputCode))
        {
            Navigation.NavigateTo($"/track/{_inputCode.Trim()}");
        }
    }

    private void NavigateToOrder(string ticketId)
    {
        Navigation.NavigateTo($"/track/{ticketId}");
    }

    private int GetProgressPercentage(int status) => status switch
    {
        (int)OrderStatus.Pending => 25,
        (int)OrderStatus.Processing => 50,
        (int)OrderStatus.Ready => 75,
        (int)OrderStatus.Delivered => 100,
        _ => 0
    };

    private string GetStatusName(int status) => status switch
    {
        (int)OrderStatus.Pending => "Chờ tiếp nhận",
        (int)OrderStatus.Processing => "Đang nấu",
        (int)OrderStatus.Ready => "Sẵn sàng",
        (int)OrderStatus.Delivered => "Đã giao",
        (int)OrderStatus.Cancelled => "Đã huỷ",
        _ => "Không rõ"
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_dotNetRef != null && !string.IsNullOrWhiteSpace(OrderCode))
            {
                await JS.InvokeVoidAsync("signalRHelper.leaveGroup", "LeaveOrderTrack", OrderCode);
            }
        }
        catch { }
        _dotNetRef?.Dispose();
    }
}
